# ==============================================================================
# NEURA AI — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder secrets with secure credentials.
# Do NOT commit actual secrets to version control.

# --- GLOBAL SYSTEM CONFIGURATION ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=neura-ai
API_V1_STR=/api/v1

# --- POSTGRESQL + PGVECTOR DATABASE ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=neura_admin
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password_in_production
POSTGRES_DB=neura_db
DATABASE_URL=postgresql+asyncpg://neura_admin:change_this_to_a_secure_postgres_password_in_production@postgres:5432/neura_db
DATABASE_SYNC_URL=postgresql://neura_admin:change_this_to_a_secure_postgres_password_in_production@postgres:5432/neura_db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# --- REDIS (Cache, Rate Limiting, Dramatiq Broker) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_secure_redis_password_in_production
REDIS_DB=0
REDIS_URL=redis://:change_this_to_a_secure_redis_password_in_production@redis:6379/0

# --- MINIO S3 OBJECT STORAGE (Documents & Model Weights) ---
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_URL=http://localhost:9000
MINIO_ROOT_USER=neura_minio_admin
MINIO_ROOT_PASSWORD=change_this_to_a_secure_minio_password_in_production
MINIO_USE_SSL=false
MINIO_DOCUMENTS_BUCKET=neura-documents
MINIO_MODELS_BUCKET=neura-models

# --- SECURITY & JWT AUTHENTICATION ---
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_hex_key_32_bytes_min
JWT_REFRESH_SECRET_KEY=change_this_to_a_secure_refresh_secret_hex_key_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- MICROSERVICES NETWORKING (Internal Docker Service URLs) ---
API_SERVICE_URL=http://api:8000
INFERENCE_SERVICE_URL=http://inference:8001
SPEECH_SERVICE_URL=http://speech:8002

# --- INFERENCE SERVICE CONFIGURATION (llama-cpp-python / E5 Embeddings) ---
MODELS_DIR=/app/models
NEURA_LM_MODEL_PATH=/app/models/neura-lm-1.5b-q4_k_m.gguf
NEURA_EMBED_MODEL_PATH=/app/models/neura-embed-small
LLAMA_N_CTX=4096
LLAMA_N_THREADS=4
LLAMA_N_GPU_LAYERS=0
INFERENCE_MAX_CONCURRENT_REQUESTS=8
INFERENCE_REQUEST_TIMEOUT_SECONDS=60

# --- SPEECH SERVICE CONFIGURATION (faster-whisper / Piper TTS / Silero VAD) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_EN_VOICE_PATH=/app/models/voices/en_US-lessac-medium.onnx
PIPER_TA_VOICE_PATH=/app/models/voices/ta_IN-indic-medium.onnx
SILERO_VAD_THRESHOLD=0.5

# --- DRAMATIQ BACKGROUND WORKERS ---
DRAMATIQ_BROKER_URL=redis://:change_this_to_a_secure_redis_password_in_production@redis:6379/1
WORKER_CONCURRENCY=4

# --- CRISIS HELPLINE SUPPORT (Tele-MANAS, Indian Student Safety) ---
TELE_MANAS_HELPLINE=14416
TELE_MANAS_TOLL_FREE=1800-891-4416

# --- FRONTEND CLIENT ENVS ---
VITE_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
