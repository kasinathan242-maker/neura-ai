# =============================================================================
# NEURA AI — environment variables
# =============================================================================
# Every value is optional. With none of them set, the app still boots and every
# screen renders; answers come from a deterministic offline engine instead of a
# model. Copy this file to `.env` for local use, or paste the values you want
# into your Vercel project's Environment Variables.
# =============================================================================

# --- Language model -----------------------------------------------------------
# Pick ONE of the two blocks below.

# (a) CLOUD — required for a Vercel deployment.
#     A serverless function cannot reach a model on your own machine, so the
#     deployed app needs a hosted, OpenAI-compatible endpoint. Works with
#     OpenAI, Groq, OpenRouter, Together, DeepInfra, Mistral, vLLM, LM Studio.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini          # must accept images for the Vision tab
# LLM_EMBED_MODEL=text-embedding-3-small

#     Groq example (fast and has a free tier):
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

#     OpenRouter example (one key, many models):
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# (b) LOCAL OLLAMA — the zero-cost path for development.
#     Install Ollama, then: ollama pull llama3.2 && ollama pull llava
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_VISION_MODEL=llava
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Force a provider instead of auto-detecting (auto | openai | ollama | offline).
# `auto` prefers a cloud key, then a reachable Ollama, then the offline engine.
# LLM_PROVIDER=auto

# LLM_TIMEOUT=55            # seconds; keep below your platform's function limit
# LLM_MAX_TOKENS=1400
# LLM_TEMPERATURE=0.7

# --- Persistence --------------------------------------------------------------
# Without these, uploaded PDFs, study plans and the knowledge graph live in the
# server's memory and vanish when the process restarts — which on serverless can
# be between two requests. Add the Upstash Redis integration in the Vercel
# dashboard and it injects KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...
# KV_PREFIX=neura
# KV_TTL_SECONDS=2592000    # 30 days

# --- Optional graph database --------------------------------------------------
# The knowledge graph works without this (it is kept in the KV store). Setting
# these additionally mirrors concepts into Neo4j over its HTTP Query API, so you
# can run Cypher against them. No extra Python dependency is added.
# NEO4J_URI=https://your-instance.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=...
# NEO4J_DATABASE=neo4j

# --- Agents -------------------------------------------------------------------
# ENABLE_WEB_SEARCH=true    # set false to stop agents reaching the open web
# AGENT_MAX_STEPS=24
# AGENT_SEARCH_RESULTS=5

# --- Limits and CORS ----------------------------------------------------------
# MAX_UPLOAD_BYTES=12582912
# MAX_PDF_CONTEXT_CHARS=18000
# Comma-separated exact origins, added to the built-in localhost/*.vercel.app rule.
# CORS_ORIGINS=https://your-domain.com

# --- Front-end (build time, must be prefixed VITE_) ---------------------------
# Leave unset for same-origin `/api`, which is correct for Vercel and for local
# development through the Vite proxy. Only set it when the API lives elsewhere,
# such as in the Capacitor or Expo shells.
# VITE_API_BASE=https://your-api.example.com/api
# VITE_DEV_API=http://127.0.0.1:8001
